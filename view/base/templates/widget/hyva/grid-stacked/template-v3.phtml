<?php

use MageOS\Widgetkit\Block\Widgets\GridStacked;
use Magento\Framework\Escaper;

/**
 * @var GridStacked $this
 * @var Escaper $escaper
 *
 * Left column: the widget-level title + description, sticky on desktop.
 * Right column: every item stacked below each other (each item's own image/title/
 * content, reusing the v1 per-item row layout). The "alternate" setting is
 * intentionally ignored here — item order never flips.
 */

$params = $this->getData('params');
$items  = $this->getData('items') ?: [];

$titleType = $params['mageos_grid_stacked_title_type'] ?? 'h2';
$titleCssClasses = $params['mageos_grid_stacked_title_classes'] ?? '';
$descriptionCssClasses = $params['mageos_grid_stacked_description_classes'] ?? '';

$itemTitleClass = trim('text-left ' . ($params['mageos_grid_stacked_item_title_classes'] ?? ''));
$itemContentClass = trim('text-left ' . ($params['mageos_grid_stacked_item_content_classes'] ?? ''));
$contentWrapperClass = trim($params['mageos_grid_stacked_item_content_container_classes'] ?? '');
?>

<div class="grid-stacked grid-stacked--v3 flex flex-col md:flex-row gap-2">
    <div class="grid-stacked--v3__aside w-full md:w-1/3">
        <div class="md:sticky md:top-[150px]">
            <?php if (!empty($params['mageos_grid_stacked_title'])): ?>
            <<?= $titleType ?> class="<?= $escaper->escapeHtmlAttr($titleCssClasses); ?>">
                <?= /* @noEscape */ $params['mageos_grid_stacked_title']; ?>
            </<?= $titleType ?>>
            <?php endif; ?>
            <?php if (!empty($params['mageos_grid_stacked_description'])): ?>
            <div class="<?= $escaper->escapeHtmlAttr($descriptionCssClasses); ?>">
                <?= \MageOS\Widgetkit\Model\RichTextDecoder::decode($params['mageos_grid_stacked_description']); ?>
            </div>
            <?php endif; ?>
        </div>
    </div>

    <div class="grid-stacked--v3__items w-full md:w-2/3 flex flex-col gap-2">
        <?php foreach ($items as $index => $item): ?>
            <?php
            $loading = $params['mageos_grid_stacked_image_loading'] ?? 'lazy';
            $mobileImage = $item['mobile_image'] ?? null;
            $hasLink    = !empty($item['button_link']);
            $linkTarget = $item['button_link_target'] ?? '_self';
            $hasContent = !empty($item['title']) || !empty($item['content']);
            ?>
            <div class="grid-stacked-item <?php if ($item['use_card'] === "true"): ?>card card-interactive<?php endif; ?> flex flex-col md:flex-row w-full items-center gap-2">
                <?php if (!empty($item['image'])): ?>
                <div class="w-full md:w-1/2">
                    <picture class="block w-full">
                        <?php if ($mobileImage): ?>
                        <source
                            media="(max-width: 768px)"
                            srcset="<?= $escaper->escapeHtmlAttr($mobileImage) ?>"
                            type="image/jpeg"
                        />
                        <?php endif; ?>
                        <img
                            src="<?= $escaper->escapeUrl($item['image']) ?>"
                            alt="<?= $escaper->escapeHtmlAttr($item['image_alt'] ?? '') ?>"
                            class="w-full h-auto object-cover"
                            loading="<?= $loading === 'eager' ? 'eager' : 'lazy' ?>"
                        />
                    </picture>
                </div>
                <?php endif; ?>

                <?php if ($hasContent): ?>
                <div class="w-full md:w-1/2 <?= $escaper->escapeHtmlAttr($contentWrapperClass); ?>">
                    <?php if (!empty($item['title'])): ?>
                    <<?= $item['title_tag'] ?? 'h3' ?> class="<?= $itemTitleClass; ?>">
                        <?= $escaper->escapeHtml(\MageOS\Widgetkit\Model\RichTextDecoder::decode($item['title'])); ?>
                    </<?= $item['title_tag'] ?? 'h3' ?>>
                    <?php endif; ?>
                    <?php if (!empty($item['content'])): ?>
                    <div class="<?= $itemContentClass; ?>">
                        <?= $escaper->escapeHtml(\MageOS\Widgetkit\Model\RichTextDecoder::decode($item['content'])); ?>
                    </div>
                    <?php endif; ?>
                    <?php if ($hasLink && !empty($item['button'])): ?>
                    <div class="pt-2">
                        <a
                            href="<?= $escaper->escapeUrl($item['button_link']) ?>"
                            target="<?= $escaper->escapeHtmlAttr($linkTarget) ?>"
                            class="btn btn-primary"
                            <?php if ($linkTarget === '_blank'): ?>
                            rel="noopener noreferrer"
                            <?php endif; ?>
                        >
                            <?= $escaper->escapeHtml(\MageOS\Widgetkit\Model\RichTextDecoder::decode($item['button'])); ?>
                        </a>
                    </div>
                    <?php endif; ?>
                </div>
                <?php endif; ?>
            </div>
        <?php endforeach; ?>
    </div>
</div>
