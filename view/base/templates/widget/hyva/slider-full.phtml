<?php endif; ?>

<?php if (!empty($this->getData('mageos_slider_description'))): ?>
<div class="<?= $escaper->escapeHtmlAttr($descriptionCssClasses ?? ''); ?>">
    <?= \MageOS\Widgetkit\Model\RichTextDecoder::html($this->getData('mageos_slider_description')); ?>
