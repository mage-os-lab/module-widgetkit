<?php
/**
 * "Full" carousel template variant - a self-contained Alpine.js carousel with the same
 * characteristics as the Splide.js-based version this replaced (no external library, so
 * nothing to load): a segmented progress-bar pagination (each page gets an equal-width
 * segment of a full-width bar, active one filled solid), a slide gap, and a small
 * edge-padding "peek" that avoids empty trailing space on a not-fully-populated last page.
 * Items are rendered once (plain PHP foreach, not an Alpine x-for) since the item *set*
 * never changes at runtime - only which page is visible, driven by a CSS transform.
 *
 * No looping: next()/prev() clamp at the first/last page instead of wrapping around, and
 * the slidenav buttons disable at those boundaries - same convention as the native
 * x-snap-slider template's own prev/next buttons. The last page always shows a full
 * `perPage` real items ending at the final item, instead of a short page with fewer items
 * than perPage, by clamping its start index (see startIndex()).
 *
 * Edge peek: padding-left is a small fixed px value, padding-right a percentage of the
 * track's content width sized so part of the next item beyond the current page peeks in
 * (rightPeekPercent()) - both plain CSS, no JS measurement needed for either. On the last
 * page specifically these two swap sides: padding-left becomes the (same) percentage
 * instead - peeking the *previous* item you scrolled past - and padding-right becomes the
 * small fixed value, so the very last item ends with the same small trailing margin the
 * first item started with, rather than a dead gap sized for a peek that has nothing after
 * it to show.
 *
 * Item width itself IS measured (track content-box width in px, via getBoundingClientRect)
 * since translateX needs a real pixel distance to move by whole items - CSS percentages
 * don't compose cleanly here because the transform's own "%" reference frame is the list's
 * total width (all items together), not the track's visible width. measure() re-runs on
 * mount, on window resize, and after any page/perPage change (padding differs between the
 * last page and every other page, which shifts the available content width slightly).
 *
 * Drag: a plain pointerdown/pointermove/pointerup distance threshold (no velocity/flick
 * simulation) - past the threshold, releases to the next/previous page; short of it, snaps
 * back to the current one.
 *
 * No autoplay: auto-advancing content without a pause control fails WCAG 2.2.2. Navigation
 * here is manual only - the slidenav prev/next buttons and the pagination bar.
 */

declare(strict_types=1);

use MageOS\Widgetkit\Block\Widgets\Slider;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;

/**
 * @var Slider $this
 * @var HyvaCsp $hyvaCsp
 * @var Escaper $escaper
 */

$params   = $this->getData('params');
$items    = $this->getData('items');
$uniqId   = uniqid();
$sliderId = 'slider-' . $uniqId;

$totalItems = count($items);

$desktopRealItems = max(1, (int) ($params['mageos_slider_columns'] ?? 3));
$tabletRealItems  = max(1, (int) floor($desktopRealItems / 2));
$mobileRealItems  = 1;

$navVisibility      = $params['mageos_slider_navigation_visibility'] ?? 'show';
$slidenavVisibility = $params['mageos_slider_slidenav_visibility'] ?? 'show';

$gapPx = 8; // 0.5rem

// See widget/hyva/slider/template-full-aside.phtml for the full rationale (a real,
// measured layout-shift bug): the static width/padding below is what renders before Alpine
// mounts and measures anything, so it needs to already match what measure() will compute -
// both the "fewer real items than columns" clamp and the track's own edge-padding (peek)
// reduce the space items actually have, and a naive 100%-of-unpadded-width calc is always
// wider than the real, padding-aware result, guaranteeing a shrink transition otherwise.
$effectiveDesktopItems = max(1, min($desktopRealItems, $totalItems));
$itemBasisCss = 'calc((100% - ' . ($gapPx * ($effectiveDesktopItems - 1)) . 'px) / ' . $effectiveDesktopItems . ')';
$hideControlsInitially = $effectiveDesktopItems >= $totalItems;
$rightPeekPercent = 80 / ($effectiveDesktopItems + 0.8);
$trackPaddingCss = $hideControlsInitially
    ? 'padding-left: 0; padding-right: 0;'
    : 'padding-left: 24px; padding-right: ' . round($rightPeekPercent, 4) . '%;';
?>

<section
    id="<?= $escaper->escapeHtmlAttr($sliderId) ?>"
    class="relative"
    aria-label="<?= $escaper->escapeHtmlAttr(\MageOS\Widgetkit\Model\RichTextDecoder::decode($params['mageos_slider_title'] ?? '')) ?>"
    aria-roledescription="<?= $escaper->escapeHtmlAttr(__('Carousel')) ?>"
    data-slider-type="generic"
    x-data="initSlider<?= $uniqId ?>()"
    x-defer="intersect"
>
    <a
        href="#<?= $escaper->escapeHtmlAttr($sliderId) ?>-slider-end"
        class="sr-only focus:not-sr-only focus:absolute focus:z-30 focus:bg-white"
    ><?= $escaper->escapeHtml(__('Press to skip carousel')) ?></a>

    <?php if ($navVisibility !== 'hide' || $slidenavVisibility !== 'hide'): ?>
    <div class="items-center gap-4 mb-2 flex" x-show="pageCount > 1">
        <?php if ($navVisibility !== 'hide'): ?>
        <nav class="flex-1 snap-pager justify-start px-2" aria-label="<?= $escaper->escapeHtmlAttr(__('Slide navigation')) ?>">
            <template x-for="i in pageCount" :key="i">
                <button
                    type="button"
                    class="snap-marker"
                    x-on:click="goToPage(i - 1)"
                    x-bind:aria-current="i - 1 === page ? 'true' : undefined"
                    x-bind:aria-label="`<?= $escaper->escapeJs(__('Go to slide')) ?> ${i} <?= $escaper->escapeJs(__('of')) ?> ${pageCount}`"
                ></button>
            </template>
        </nav>
        <?php endif; ?>

        <?php if ($slidenavVisibility !== 'hide'): ?>
        <div class="flex shrink-0 gap-2 justify-end px-2">
            <button
                type="button"
                class="btn btn-secondary p-2"
                aria-label="<?= $escaper->escapeHtml(__('Previous Slide')) ?>"
                @click="prev()"
                data-prev
                x-bind:disabled="page === 0"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor"
                     stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24"
                     class="rtl:-rotate-180" aria-hidden="true">
                    <path d="m12 19-7-7 7-7M19 12H5"></path>
                </svg>
            </button>
            <button
                type="button"
                class="btn btn-secondary p-2"
                aria-label="<?= $escaper->escapeHtml(__('Next Slide')) ?>"
                @click="next()"
                data-next
                x-bind:disabled="page >= pageCount - 1"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor"
                     stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24"
                     class="rtl:-rotate-180" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
            </button>
        </div>
        <?php endif; ?>
    </div>
    <?php endif; ?>

    <div
        class="relative overflow-hidden"
        x-ref="track"
        style="<?= $trackPaddingCss ?>"
        x-bind:style="trackWidth ? { paddingLeft: edgePadding.left + 'px', paddingRight: edgePadding.right + 'px' } : {}"
    >
        <div
            class="flex"
            x-ref="list"
            x-bind:style="{
                gap: '<?= $gapPx ?>px',
                transform: 'translateX(' + (-translateX) + 'px)',
                transition: dragging ? 'none' : 'transform 300ms cubic-bezier(0.25, 1, 0.5, 1), padding 300ms cubic-bezier(0.25, 1, 0.5, 1)'
            }"
            x-on:pointerdown="onDragStart($event)"
            x-on:pointermove="onDragMove($event)"
            x-on:pointerup="onDragEnd($event)"
            x-on:pointercancel="onDragEnd($event)"
            style="touch-action: pan-y;"
        >
            <?php $slideIndex = 1; ?>
            <?php foreach ($items as $index => $item): ?>
                <?php $item['count'] = $index; ?>
                <div
                    class="shrink-0"
                    role="group"
                    aria-roledescription="<?= $escaper->escapeHtmlAttr(__('slide')) ?>"
                    aria-label="<?= $escaper->escapeHtmlAttr($slideIndex++ . ' / ' . count($items)) ?>"
                    x-bind:style="itemWidth ? { width: itemWidth + 'px' } : {}"
                    style="width: <?= $itemBasisCss ?>"
                >
                    <?php
                    $loading = $item['count'] === 0
                        ? 'eager'
                        : ($params['mageos_slider_image_loading'] ?? 'lazy');
                    $mobileImage = $item['mobile_image'] ?? null;
                    $hasLink    = !empty($item['button_link']) && empty($item['button']);
                    $linkTarget = $item['button_link_target'] ?? '_self';

                    $itemTitleClass = trim('text-left ' . ($params['mageos_slider_item_title_classes'] ?? ''));
                    $itemContentClass = trim('text-left ' . ($params['mageos_slider_item_content_classes'] ?? ''));
                    $contentWrapperClass = trim($params['mageos_slider_item_content_container_classes'] ?? '');

                    $hasContent = !empty($item['title']) || !empty($item['content']);
                    ?>
                    <div class="slider-item card card-interactive grow flex flex-col w-full h-full">
                        <?php if ($hasLink): ?>
                        <a
                            href="<?= $escaper->escapeUrl($item['button_link']) ?>"
                            target="<?= $escaper->escapeHtmlAttr($linkTarget) ?>"
                            class="flex flex-col h-full"
                            x-bind:class="{ 'pointer-events-none': dragging }"
                            <?php if ($linkTarget === '_blank'): ?>
                            rel="noopener noreferrer"
                            <?php endif; ?>
                        >
                        <?php else: ?>
                        <div class="flex flex-col h-full">
                        <?php endif; ?>

                            <?php /**
                             * aspect-square + overflow-hidden reserves the image's box before
                             * it loads (h-auto alone leaves it height:0 until the image
                             * resolves, visibly collapsing/re-expanding the whole slide and,
                             * since these sit in a row together, the whole carousel section -
                             * as each one loads). object-cover (on the h-full img) crops
                             * arbitrary admin-uploaded images to fit, same convention as
                             * grid-stacked's own v2 template.
                             */ ?>
                            <picture class="block w-full overflow-hidden" style="aspect-ratio: 1 / 1;">
                                <?php if ($mobileImage): ?>
                                <source
                                    media="(max-width: 768px)"
                                    srcset="<?= $escaper->escapeHtmlAttr($mobileImage) ?>"
                                    type="image/jpeg"
                                />
                                <?php endif; ?>
                                <img
                                    src="<?= $escaper->escapeUrl($item['image']) ?>"
                                    alt="<?= $escaper->escapeHtmlAttr($item['image_alt'] ?? '') ?>"
                                    class="w-full h-full object-cover pointer-events-none"
                                    draggable="false"
                                    <?php if ($loading === 'eager'): ?>
                                    loading="eager"
                                    fetchpriority="high"
                                    <?php else: ?>
                                    loading="lazy"
                                    <?php endif; ?>
                                />
                            </picture>

                            <?php if ($hasContent): ?>
                            <div class="w-full grow <?= $escaper->escapeHtmlAttr($contentWrapperClass); ?>">
                                <?php if (!empty($item['title'])): ?>
                                <div class="<?= $itemTitleClass; ?>">
                                    <?= $escaper->escapeHtml(\MageOS\Widgetkit\Model\RichTextDecoder::decode($item['title'])); ?>
                                </div>
                                <?php endif; ?>
                                <?php if (!empty($item['content'])): ?>
                                <div class="<?= $itemContentClass; ?>">
                                    <?= $escaper->escapeHtml(\MageOS\Widgetkit\Model\RichTextDecoder::decode($item['content'])); ?>
                                </div>
                                <?php endif; ?>
                                <?php if (!empty($item['button']) && !empty($item['button_link'])): ?>
                                <div class="pt-2">
                                    <a
                                        href="<?= $escaper->escapeUrl($item['button_link']) ?>"
                                        target="<?= $escaper->escapeHtmlAttr($linkTarget) ?>"
                                        class="btn btn-primary"
                                        x-bind:class="{ 'pointer-events-none': dragging }"
                                        <?php if ($linkTarget === '_blank'): ?>
                                        rel="noopener noreferrer"
                                        <?php endif; ?>
                                    >
                                        <?= $escaper->escapeHtml(\MageOS\Widgetkit\Model\RichTextDecoder::decode($item['button'])); ?>
                                    </a>
                                </div>
                                <?php endif; ?>
                            </div>
                            <?php endif; ?>

                        <?php if ($hasLink): ?>
                        </a>
                        <?php else: ?>
                        </div>
                        <?php endif; ?>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
    </div>

    <span id="<?= $escaper->escapeHtmlAttr($sliderId) ?>-slider-end" tabindex="-1"></span>
</section>

<script>
    function initSlider<?= $uniqId ?>() {
        return {
            totalItems: <?= (int) $totalItems ?>,
            perPageByBreakpoint: { desktop: <?= $desktopRealItems ?>, tablet: <?= $tabletRealItems ?>, mobile: <?= $mobileRealItems ?> },
            edgePeekPxByBreakpoint: { desktop: 24, tablet: 24, mobile: 16 },
            gap: <?= $gapPx ?>,

            perPage: <?= $desktopRealItems ?>,
            page: 0,
            trackWidth: 0,
            itemWidth: 0,
            dragging: false,
            dragStartX: 0,
            dragDeltaX: 0,
            pointerDownId: null,
            resizeHandler: null,

            init() {
                this.recalcPerPage();
                <?php /**
                 * $refs.track (x-ref="track" on a descendant) isn't guaranteed populated yet
                 * during this component's own init() - Alpine hasn't necessarily finished
                 * walking down to that child element yet. measure() silently no-ops without
                 * it (guarded below), which left itemWidth stuck at its initial 0 - and since
                 * x-bind:style="{width: itemWidth+'px'}" *replaces* the static CSS fallback
                 * width the moment Alpine binds it, every slide collapsed to zero width (and,
                 * with aspect-square, zero height) until something else happened to trigger a
                 * re-measure. $nextTick() waits until Alpine has flushed the initial DOM
                 * walk/bindings, guaranteeing the ref exists.
                 */ ?>
                this.$nextTick(() => this.measure());
                this.resizeHandler = () => { this.recalcPerPage(); this.measure(); };
                window.addEventListener('resize', this.resizeHandler);
            },

            destroy() {
                if (this.resizeHandler) {
                    window.removeEventListener('resize', this.resizeHandler);
                }
            },

            currentBreakpoint() {
                const w = window.innerWidth;
                if (w < 640) return 'mobile';
                if (w < 1024) return 'tablet';
                return 'desktop';
            },

            recalcPerPage() {
                const bp = this.currentBreakpoint();
                const newPerPage = Math.max(1, Math.min(this.perPageByBreakpoint[bp], this.totalItems));
                this.perPage = newPerPage;
                this.page = Math.min(this.page, Math.max(0, this.pageCount - 1));
            },

            get pageCount() {
                return Math.max(1, Math.ceil(this.totalItems / this.perPage));
            },

            get hideControls() {
                return this.perPage >= this.totalItems;
            },

            // trimSpace-equivalent: the last page always shows a full `perPage` real items
            // ending at the final item, instead of a short page with fewer items.
            get startIndex() {
                const naive = this.page * this.perPage;
                const maxStart = Math.max(0, this.totalItems - this.perPage);
                return Math.min(naive, maxStart);
            },

            get isLastPage() {
                return this.startIndex + this.perPage >= this.totalItems;
            },

            rightPeekPercent() {
                return 80 / (this.perPage + 0.8);
            },

            get edgePadding() {
                if (this.hideControls) {
                    return { left: 0, right: 0 };
                }
                const bp = this.currentBreakpoint();
                const fixedPeek = this.edgePeekPxByBreakpoint[bp];
                const percentPeekPx = this.trackWidth * (this.rightPeekPercent() / 100);
                return this.isLastPage
                    ? { left: percentPeekPx, right: fixedPeek }
                    : { left: fixedPeek, right: percentPeekPx };
            },

            get translateX() {
                return this.startIndex * (this.itemWidth + this.gap);
            },

            measure() {
                if (!this.$refs.track) return;
                this.trackWidth = this.$refs.track.getBoundingClientRect().width;
                const padding = this.edgePadding;
                const contentWidth = Math.max(0, this.trackWidth - padding.left - padding.right);
                this.itemWidth = (contentWidth - (this.perPage - 1) * this.gap) / this.perPage;
            },

            goToPage(index) {
                this.page = Math.max(0, Math.min(index, this.pageCount - 1));
                this.$nextTick(() => this.measure());
            },

            next() {
                if (this.page >= this.pageCount - 1) return;
                this.page++;
                this.$nextTick(() => this.measure());
            },

            prev() {
                if (this.page <= 0) return;
                this.page--;
                this.$nextTick(() => this.measure());
            },

            onDragStart(event) {
                if (this.hideControls) return;
                this.pointerDownId = event.pointerId;
                this.dragStartX = event.clientX;
                this.dragDeltaX = 0;
            },

            onDragMove(event) {
                if (this.pointerDownId === null || event.pointerId !== this.pointerDownId) return;
                this.dragDeltaX = event.clientX - this.dragStartX;
                if (!this.dragging && Math.abs(this.dragDeltaX) > 5) {
                    // Only now commit to an actual drag - capturing the pointer here (not on
                    // pointerdown) means a plain tap/click never moves past this threshold, so
                    // it still reaches the anchor/button underneath instead of being swallowed.
                    this.dragging = true;
                    this.$refs.list.setPointerCapture?.(event.pointerId);
                }
            },

            onDragEnd(event) {
                this.pointerDownId = null;
                if (!this.dragging) return;
                this.dragging = false;
                if (event?.pointerId !== undefined) {
                    this.$refs.list.releasePointerCapture?.(event.pointerId);
                }
                const threshold = Math.max(this.itemWidth * 0.2, 50);
                if (this.dragDeltaX <= -threshold) {
                    this.next();
                } else if (this.dragDeltaX >= threshold) {
                    this.prev();
                }
                this.dragDeltaX = 0;
            },
        }
    }
    window.addEventListener('alpine:init', () => Alpine.data('initSlider<?= $uniqId ?>', initSlider<?= $uniqId ?>), {once: true})
</script>
<?php $hyvaCsp->registerInlineScript() ?>
